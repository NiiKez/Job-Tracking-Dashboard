# Names only. Copy to .env.local for development and fill in there; never commit values.
# The build needs none of these. An empty value counts as missing; a value that is present but
# malformed stops the start. Outside production a missing value switches its feature off. In
# production (`next start`) the start also stops without sign-in or INBOX_TOKEN_KEY (unless
# ALLOW_PARTIAL_SETUP=on) and with MAIL_SOURCE=fixture (unless APP_URL is an http loopback origin).

# PostgreSQL connection, postgres:// or postgresql:// (the only value needed to start)
DATABASE_URL=
# Public origin of the app, no path (development: http://localhost:3800). Redirect addresses and
# cookie flags are built from it. Missing: sign-in stays locked.
APP_URL=

# Google OAuth client, used by sign-in and the Gmail connection. Missing: sign-in stays locked.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of accounts that may sign in. Missing: sign-in stays locked.
ALLOWED_EMAILS=

# 32 random bytes as 64 hex characters; encrypts the Gmail refresh token. Missing: Gmail is not set up.
INBOX_TOKEN_KEY=
# Optional: the old key while rotating
INBOX_TOKEN_KEY_PREVIOUS=
# gmail (default) or fixture: invented mail from fixtures/mail, for development, tests and CI.
# Production refuses to start with fixture, unless APP_URL is http on 127.0.0.1, localhost or
# [::1] (a production build run locally, e.g. scripts/scheduler-check.mts).
MAIL_SOURCE=
# on (default) or off. off stops the timed Gmail syncs only; the 90-day clean-up and the
# no-response sweep run either way.
INBOX_SCHEDULER=
# Optional: days of mail to scan on first connect, 1 to 365 (default 30)
INBOX_BACKFILL_DAYS=
# Production only: on or off (default). on lets the app start without sign-in (it stays locked)
# or without INBOX_TOKEN_KEY (no Gmail), for a self-hoster who wants that. It does not allow
# MAIL_SOURCE=fixture. Outside production a missing value never stops the start anyway.
ALLOW_PARTIAL_SETUP=

# Development and CI only: database for the tests
TEST_DATABASE_URL=
